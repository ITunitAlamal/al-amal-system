{
  "name": "aims-field-client",
  "productName": "AIMS Field Distribution",
  "version": "1.0.0",
  "description": "Windows field-distribution client for AIMS relief campaigns (Sponsorships & Orphans department): signed manifests, 168-hour offline window, encrypted outbox, recipient identity check and handwritten signature.",
  "main": "src/main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "ps.alamal.aims.field",
    "productName": "AIMS Field Distribution",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "package.json"],
    "win": { "target": ["nsis"], "artifactName": "aims-field-setup-${version}.exe" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": false, "language": "1025" },
    "asar": true
  }
}
